<?xml version="1.0" encoding="UTF-8"?>
<trackerinfo type="added-fixture" shortName="Added" longName="Added tracker fixture">
  <settings>
    <description />
  </settings>
  <servers>
    <server network="added.invalid" channelNames="#added" announcerNames="fixture" />
  </servers>
  <parseinfo>
    <linepatterns>
      <extract>
        <regex value="^(.+)$" />
        <vars><var name="torrentName" /></vars>
      </extract>
    </linepatterns>
    <linematched />
    <ignore />
  </parseinfo>
</trackerinfo>
